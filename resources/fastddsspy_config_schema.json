{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "$ref":"#/definitions/BaseObject",
    "definitions":{
        "BaseObject":{
            "type":["object","null"],
            "additionalProperties":false,
            "properties":{
                "dds":{
                    "$ref":"#/definitions/DDSConfigSpy"
                },
                "specs":{
                    "$ref":"#/definitions/SpecsConfig"
                }
            },
            "title":"BaseObject"
        },
        "DDSConfigSpy":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "xml":{
                    "type":"object",
                    "additionalProperties":false,
                    "properties":{
                        "raw":{
                            "type":"string"
                        },
                        "files":{
                            "type":"array",
                            "minItems":1,
                            "items":{
                                "type":"string"
                            }
                        }
                    },
                    "anyOf":[
                        {
                            "required":[
                                "raw"
                            ]
                        },
                        {
                            "required":[
                                "files"
                            ]
                        }
                    ]
                },
                "dds-profile":{
                    "type":"string"
                },
                "domain":{
                    "$ref":"#/definitions/DdsDomain"
                },
                "whitelist-interfaces":{
                    "type":"array",
                    "items":{
                        "type":"string"
                    }
                },
                "partitions":{
                    "type":"array",
                    "items":{
                        "type":"string"
                    }
                },
                "transport":{
                    "type":"string",
                    "enum":[
                        "builtin",
                        "udp",
                        "shm"
                    ]
                },
                "ros2-easy-mode":{
                    "$ref":"#/definitions/IPv4"
                },
                "ignore-participant-flags":{
                    "type":"string",
                    "enum":[
                        "no_filter",
                        "filter_different_host",
                        "filter_different_process",
                        "filter_same_process",
                        "filter_different_and_same_process"
                    ]
                },
                "allowlist":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/TopicFilter"
                    }
                },
                "blocklist":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/TopicFilter"
                    }
                },
                "topics":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/ManualTopic"
                    }
                },
                "ros2-types":{
                    "type":"boolean"
                }
            },
            "title":"DDSConfigSpy"
        },
        "SpecsConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "threads":{
                    "type":"integer",
                    "minimum":1
                },
                "qos":{
                    "$ref":"#/definitions/QOSSpy"
                },
                "discovery-time":{
                    "type":"integer",
                    "minimum":0
                },
                "rtps":{
                    "type":"boolean"
                },
                "logging":{
                    "$ref":"#/definitions/LogConfig"
                }
            },
            "title":"SpecsConfig"
        },
        "QOSSpy":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "durability":{
                    "type":"boolean"
                },
                "reliability":{
                    "type":"boolean"
                },
                "ownership":{
                    "type":"boolean"
                },
                "partitions":{
                    "type":"boolean"
                },
                "history-depth":{
                    "type":"integer",
                    "minimum":0
                },
                "keyed":{
                    "type":"boolean"
                },
                "max-rx-rate":{
                    "type":"number",
                    "minimum":0
                },
                "downsampling":{
                    "type":"integer",
                    "exclusiveMinimum":0
                },
                "endpoint-profile-name":{
                    "type":"string"
                }
            },
            "title":"QOSSpy"
        },
        "LogConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "publish":{
                    "type":"object",
                    "additionalProperties":false,
                    "properties":{
                        "enable":{
                            "type":"boolean"
                        },
                        "domain":{
                            "$ref":"#/definitions/DdsDomain"
                        },
                        "topic-name":{
                            "type":"string"
                        }
                    },
                    "required":[
                        "enable"
                    ]
                },
                "stdout":{
                    "type":"boolean"
                },
                "verbosity":{
                    "type":"string",
                    "enum":[
                        "info",
                        "warning",
                        "error"
                    ]
                },
                "filter":{
                    "type":"object",
                    "additionalProperties":false,
                    "properties":{
                        "info":{
                            "type":"string"
                        },
                        "warning":{
                            "type":"string"
                        },
                        "error":{
                            "type":"string"
                        }
                    }
                }
            },
            "title":"LogConfig"
        },
        "TopicFilter":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "name":{
                    "type":"string"
                },
                "type":{
                    "type":"string"
                },
                "qos":{
                    "$ref":"#/definitions/QOSSpy"
                },
                "filter":{
                    "type":"string"
                }
            },
            "required":[
                "name"
            ],
            "title":"TopicFilter"
        },
        "ManualTopic":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "name":{
                    "type":"string"
                },
                "type":{
                    "type":"string"
                },
                "qos":{
                    "$ref":"#/definitions/QOSSpy"
                },
                "filter":{
                    "type":"string"
                },
                "participants":{
                    "type":"array",
                    "items":{
                        "type":"string"
                    }
                }
            },
            "required":[
                "name"
            ],
            "title":"ManualTopic"
        },
        "IPv4":{
            "type":"string",
            "format":"v4",
            "title":"IPv4"
        },
        "DdsDomain":{
            "type":"integer",
            "minimum":0,
            "maximum":232,
            "title":"DdsDomain"
        }
    }
}
